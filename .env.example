# Database
DATABASE_URL="postgresql://user:password@localhost:5432/educoin_db?schema=public"
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=erp_data
POSTGRES_PORT=5436
REDIS_PORT=6389
REDIS_URL=redis://127.0.0.1:6389

# Server
PORT=3000
NODE_ENV=development
REQUEST_TIMEOUT_MS=1800000
BODY_LIMIT=10mb
VIDEO_UPLOAD_MAX_SIZE=524288000
HOMEWORK_UPLOAD_MAX_SIZE=52428800
IMAGE_UPLOAD_MAX_SIZE=5242880

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# Security (change in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
REGISTER_OTP_TTL_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM=your-email@example.com

# SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+12345678901

# SMS notifications (Eskiz fallback)
ESKIZ_EMAIL=your_eskiz_login_email
ESKIZ_PASSWORD=your_eskiz_login_password
ESKIZ_FROM=4546

# Legacy aliases supported for Eskiz auth
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=4546
