NODE_ENV=production
PORT=8002

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erm_data_pass
POSTGRES_DB=erp_data
POSTGRES_PORT=5458
REDIS_PORT=6389
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://erp_user:erm_data_pass@db:5432/erp_data?schema=public
JWT_SECRET=jwt-56_secret_98_my
REGISTER_OTP_TTL_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5

FRONTEND_URLS=https://crmfrontend-pied.vercel.app/login

RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=20

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM=your-email@example.com

# SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# SMS notifications (Eskiz fallback)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
