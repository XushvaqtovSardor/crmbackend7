NODE_ENV=production
PORT=8002

POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erm_data_pass
POSTGRES_DB=erp_data
POSTGRES_PORT=5458
REDIS_PORT=6389
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://erp_user:erm_data_pass@db:5432/erp_data?schema=public
JWT_SECRET=jwt-56_secret_98_my
REGISTER_OTP_TTL_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5
REQUEST_TIMEOUT_MS=1800000
BODY_LIMIT=10mb
VIDEO_UPLOAD_MAX_SIZE=524288000
HOMEWORK_UPLOAD_MAX_SIZE=52428800
IMAGE_UPLOAD_MAX_SIZE=5242880

FRONTEND_URLS=https://www.lurnex.tech,https://lurnex.tech,https://crmfrontend-pied.vercel.app

RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=20

# Email notifications (SMTP)
